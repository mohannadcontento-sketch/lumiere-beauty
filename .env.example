# ---------------------------------------------------------------
# Lumière Beauty — Environment Variables (example)
# Copy this file to ".env" and adjust values as needed.
# The demo runs fully client-side, so most of these are optional.
# ---------------------------------------------------------------

# Next.js
NEXT_PUBLIC_APP_NAME="Lumière Beauty"
NEXT_PUBLIC_APP_NAME_AR="لوميير بيوتي"

# (Optional) Enable if you later wire a real database.
# DATABASE_URL="file:./db/custom.db"

# (Optional) NextAuth — only if you add server-side auth later.
# NEXTAUTH_SECRET="change-me"
# NEXTAUTH_URL="http://localhost:3000"
